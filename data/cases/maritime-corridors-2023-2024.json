  "claims": [
    {
      "id": "claim-redsea-reroute",
      "statement": "Атаки на коммерческие суда способствовали обходу Красного моря и сокращению проходов через Суэц",
      "mechanism": "Безопасность перевозок → изменение судоходного маршрута → снижение проходов Суэцкого канала",
      "alternatives": [
        "Регулярная сезонность",
        "Изменение транспортного спроса",
        "Изменение состава флота"
      ],
      "falsification": "Оценить AIS-маршруты по перевозчикам и сопоставить до и после нападений и с контрольными маршрутами.",
      "review_status": "under_review",
      "evidence_source_ids": [
        "source-unctad-shipping-2024"
      ],
      "author": "World Information initial research"
    },
    {
      "id": "claim-panama-water",
      "statement": "Маловодье могло ограничить пропускную способность Панамского канала",
      "mechanism": "Гидрологические ограничения → сокращение разрешённых проходов",
      "alternatives": [
        "Плановые ограничения на ремонт",
        "Изменение мирового спроса"
      ],
      "falsification": "Сопоставить официальные данные о глубине воды, регламент проходов и реальные транзиты.",
      "review_status": "under_review",
      "evidence_source_ids": [
        "source-unctad-shipping-2024"
      ],
      "author": "World Information initial research"
    },
    {
      "id": "claim-freight-inflation",
      "statement": "Транспортные нарушения могли увеличить стоимость морских перевозок и потребительские цены",
      "mechanism": "Рерутинг увеличивает длину плеча/время, что меняет фрахт и потенциально инфляцию",
      "alternatives": [
        "Состояние спроса",
        "Топливные цены",
        "Валютные колебания"
      ],
      "falsification": "Использовать реальные ставки перевозок и ценовые индексы с сопоставимыми контрольными торговыми маршрутами.",
      "review_status": "under_review",
      "evidence_source_ids": [
        "source-unctad-shipping-2024"
      ],
      "author": "World Information initial research"
    }
  ],
