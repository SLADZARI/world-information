{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SLADZARI/world-information/blob/main/schemas/bilateral-relations.schema.json",
  "title": "World Information bilateral evidence registry v1",
  "description": "Attributable research records, separated from world-graph case edges; editorial review required before promoted claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "registry_id",
    "publication_status",
    "summary",
    "categories",
    "source_policy",
    "sources",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "registry_id": {
      "const": "world-information.bilateral.v1"
    },
    "publication_status": {
      "enum": [
        "research_staging_review_required",
        "approved_for_public_reuse"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 25
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "treaties",
          "trade",
          "investment",
          "sanctions",
          "territorial",
          "migration",
          "science",
          "society"
        ]
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "source_policy": {
      "type": "string",
      "minLength": 25
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "kind",
        "url",
        "title",
        "published_on",
        "retrieved_on",
        "rights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "publisher": {
          "type": "string",
          "minLength": 4
        },
        "kind": {
          "enum": [
            "primary_legal_record",
            "primary_regulatory_notice",
            "official_government_overview",
            "official_secondary_statistics",
            "official_government_event",
            "official_public_historical_context"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "published_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rights": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "pair",
        "from",
        "to",
        "direction",
        "category",
        "domain_tags",
        "type",
        "title_ru",
        "claim_ru",
        "occurred_on",
        "as_of",
        "temporal_status",
        "evidence_status",
        "review_status",
        "reviewer",
        "approved_on",
        "dispute_status",
        "legal_status",
        "source_ids",
        "measurement",
        "limitations",
        "alternatives",
        "supersedes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "pair": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "from": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "enum": [
            "directed",
            "bilateral"
          ]
        },
        "category": {
          "enum": [
            "treaties",
            "trade",
            "investment",
            "sanctions",
            "territorial",
            "migration",
            "science",
            "society"
          ]
        },
        "domain_tags": {
          "type": "array",
          "items": {
            "enum": [
              "politics",
              "economy",
              "finance",
              "energy",
              "society",
              "logistics",
              "security",
              "environment",
              "science"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "title_ru": {
          "type": "string",
          "minLength": 8
        },
        "claim_ru": {
          "type": "string",
          "minLength": 30
        },
        "occurred_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "temporal_status": {
          "enum": [
            "historical_agreement",
            "dated_measurement",
            "source_reported_snapshot",
            "undated_source_overview",
            "historical_event",
            "historical_policy_action"
          ]
        },
        "evidence_status": {
          "enum": [
            "primary_official_document",
            "official_secondary_measurement",
            "official_reported_estimate",
            "official_government_description"
          ]
        },
        "review_status": {
          "enum": [
            "review_required",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dispute_status": {
          "enum": [
            "none",
            "historically_settled",
            "documented_active",
            "contested"
          ]
        },
        "legal_status": {
          "enum": [
            "in_force_as_listed",
            "not_applicable",
            "action_recorded",
            "status_unverified"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "measurement": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value",
                "unit",
                "scale",
                "qualifier",
                "period_start",
                "period_end",
                "population_scope",
                "geography_from",
                "geography_to",
                "methodology",
                "source_id"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "goods_export_value",
                    "direct_investment_position",
                    "resident_citizens_stock"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "enum": [
                    "EUR",
                    "persons"
                  ]
                },
                "scale": {
                  "enum": [
                    "billion",
                    "units"
                  ]
                },
                "qualifier": {
                  "enum": [
                    "reported",
                    "approximately"
                  ]
                },
                "period_start": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "period_end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "population_scope": {
                  "type": "string",
                  "minLength": 12
                },
                "geography_from": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "geography_to": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "methodology": {
                  "type": "string",
                  "minLength": 25
                },
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]+$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "string",
          "minLength": 25
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 6
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit",
        "scale",
        "qualifier",
        "period_start",
        "period_end",
        "population_scope",
        "geography_from",
        "geography_to",
        "methodology",
        "source_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "goods_export_value",
            "direct_investment_position",
            "resident_citizens_stock"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "EUR",
            "persons"
          ]
        },
        "scale": {
          "enum": [
            "billion",
            "units"
          ]
        },
        "qualifier": {
          "enum": [
            "reported",
            "approximately"
          ]
        },
        "period_start": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "period_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "population_scope": {
          "type": "string",
          "minLength": 12
        },
        "geography_from": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "geography_to": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "methodology": {
          "type": "string",
          "minLength": 25
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        }
      }
    }
  }
}
