  "claims": [
    {
      "id": "claim-gas-diversify",
      "statement": "REPowerEU и рыночная адаптация связаны с изменением структуры газовых поставок ЕС",
      "mechanism": "Диверсификация источников, инфраструктура СПГ и снижение спроса",
      "alternatives": [
        "Ценовые сигналы",
        "Сокращение поставок независимо от политики",
        "Температурные условия"
      ],
      "falsification": "Сопоставить импорт по странам, спрос, цены, инфраструктурную доступность и даты решений; оценить вклад по эконометрической модели.",
      "review_status": "under_review",
      "evidence_source_ids": [
        "source-eu-council-gas-2026",
        "source-eu-commission-gas-2024"
      ],
      "author": "World Information initial research"
    },
    {
      "id": "claim-gas-industry",
      "statement": "Перестройка газового импорта могла менять издержки промышленности Германии и Польши",
      "mechanism": "Изменение контрактов и региональных цен на энергию",
      "alternatives": [
        "Валютный курс",
        "Структура промышленности",
        "Другие налоги и субсидии"
      ],
      "falsification": "Сравнить TTF, промышленный PPI, энергоёмкость и разницу между странами в сопоставимых окнах.",
      "review_status": "under_review",
