{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SLADZARI/world-information/blob/research/social-dynamics-digital-ecosystems-2026/schemas/digital-ecosystem-research.schema.json",
  "title": "World Information digital ecosystem research staging v0.1",
  "description": "Review staging, separate from existing world-graph v0.1. Values are measurements, NOT estimated causal shares.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "schema_version",
    "as_of",
    "record_status",
    "purpose",
    "sources",
    "measurements",
    "hypotheses",
    "country_context",
    "causal_effect_policy",
    "republication_policy"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "record_status": {
      "const": "review_required"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "causal_effect_policy": {
      "type": "string",
      "minLength": 30
    },
    "republication_policy": {
      "type": "string",
      "minLength": 30
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "country_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/country"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "kind",
        "url",
        "published_on",
        "retrieved_on",
        "rights",
        "limitations",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "enum": [
            "official_statistics",
            "regulator",
            "survey",
            "methodology",
            "civil_society_monitoring",
            "randomized_experiment"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        },
        "rights": {
          "type": "string",
          "minLength": 10
        },
        "limitations": {
          "type": "string",
          "minLength": 15
        },
        "status": {
          "const": "review_required"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "geography",
        "metric",
        "measurement_type",
        "value",
        "unit",
        "population_scope",
        "denominator",
        "period",
        "method",
        "limitations",
        "comparison",
        "status",
        "causal_effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "geography": {
          "type": "string",
          "pattern": "^(GLOBAL|MARKETS_[0-9]+|[A-Z]{2})$"
        },
        "metric": {
          "type": "string",
          "minLength": 4
        },
        "measurement_type": {
          "enum": [
            "coverage",
            "infrastructure_coverage",
            "self_report_news_reach",
            "market_structure",
            "attitude_survey",
            "time_use",
            "network_subscription_count",
            "user_count",
            "incident_count",
            "incident_territory_count"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 2
        },
        "population_scope": {
          "type": "string",
          "minLength": 5
        },
        "denominator": {
          "type": "string",
          "minLength": 12
        },
        "period": {
          "type": "string",
          "minLength": 4
        },
        "method": {
          "type": "string",
          "minLength": 15
        },
        "limitations": {
          "type": "string",
          "minLength": 15
        },
        "comparison": {
          "enum": [
            "=",
            ">",
            ">="
          ]
        },
        "status": {
          "const": "review_required"
        },
        "causal_effect": {
          "const": false
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "mechanism",
        "evidence_source_ids",
        "contradicting_source_ids",
        "alternatives",
        "falsification",
        "status",
        "causal_effect_estimate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 30
        },
        "mechanism": {
          "type": "string",
          "minLength": 30
        },
        "evidence_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contradicting_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "falsification": {
          "type": "string",
          "minLength": 50
        },
        "status": {
          "const": "review_required"
        },
        "causal_effect_estimate": {
          "type": "null"
        }
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country",
        "available_evidence",
        "operator_evidence",
        "platform_preferences_status",
        "open_gaps"
      ],
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "available_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "operator_evidence": {
          "type": "string"
        },
        "platform_preferences_status": {
          "enum": [
            "not_yet_validated",
            "partially_surveyed",
            "validated"
          ]
        },
        "open_gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,}$"
    }
  }
}
